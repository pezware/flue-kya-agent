# Copy to .dev.vars for local development. .dev.vars is gitignored.
# In a deployed Worker these are secrets: pnpm exec wrangler secret put <NAME>

# Gates every route except the console shell at /. Unset means the Worker
# refuses every request, which is the intended behaviour — never ship this
# Worker without it.
API_TOKEN=""

# Model provider key, for the xai/ models the agent uses.
XAI_API_KEY=""
