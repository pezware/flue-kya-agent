# Copy to .dev.vars for local development. .dev.vars is gitignored.
# In a deployed Worker these are secrets: pnpm exec wrangler secret put <NAME>

# Gates every route. Unset means the Worker refuses every request, which is the
# intended behaviour — never ship this Worker without it.
API_TOKEN=""

# Model provider key. Not needed if you switch the agent to a Workers AI model.
ANTHROPIC_API_KEY=""
